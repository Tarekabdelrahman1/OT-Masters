# 60. Compact Command Flow

Do **not** blindly paste this block until the individual values match your application.

It exists to show the overall sequence.

```bash
# GCP / GKE
export PROJECT_ID="devops-project-503113"
export REGION="europe-west1"
export CLUSTER_NAME="devsecops-gke"

gcloud container clusters get-credentials "$CLUSTER_NAME" \
  --region "$REGION" \
  --project "$PROJECT_ID"

kubectl get nodes -o wide

# Application
cd ~/devsecops/OT-Masters/app

export APP_NAME="devsecops-webapp"
export IMAGE_TAG="manual-001"

docker build -t "${APP_NAME}:${IMAGE_TAG}" .

trivy image \
  --severity HIGH,CRITICAL \
  "${APP_NAME}:${IMAGE_TAG}"

# AWS / ECR
export AWS_REGION="eu-central-1"
export ECR_REPOSITORY="devsecops-webapp"

export AWS_ACCOUNT_ID="$(aws sts get-caller-identity \
  --query Account \
  --output text)"

export ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
export ECR_REPO="${ECR_REGISTRY}/${ECR_REPOSITORY}"

aws ecr get-login-password \
  --region "$AWS_REGION" \
| docker login \
  --username AWS \
  --password-stdin "$ECR_REGISTRY"

docker tag \
  "${APP_NAME}:${IMAGE_TAG}" \
  "${ECR_REPO}:${IMAGE_TAG}"

docker push "${ECR_REPO}:${IMAGE_TAG}"

export IMAGE_DIGEST="$(aws ecr describe-images \
  --region "$AWS_REGION" \
  --repository-name "$ECR_REPOSITORY" \
  --image-ids imageTag="$IMAGE_TAG" \
  --query 'imageDetails[0].imageDigest' \
  --output text)"

export IMAGE_REF="${ECR_REPO}@${IMAGE_DIGEST}"
echo "$IMAGE_REF"

# Temporary ECR auth for staging
export ECR_PASSWORD="$(aws ecr get-login-password \
  --region "$AWS_REGION")"

kubectl create secret docker-registry ecr-registry \
  --namespace staging \
  --docker-server="$ECR_REGISTRY" \
  --docker-username="AWS" \
  --docker-password="$ECR_PASSWORD" \
  --dry-run=client \
  -o yaml \
| kubectl apply -f -

unset ECR_PASSWORD

# Kubernetes staging
cd ~/devsecops/OT-Masters

kubectl apply --dry-run=server -f k8s/staging/
kubectl diff -f k8s/staging/
kubectl apply -f k8s/staging/

kubectl get all -n staging

kubectl rollout status \
  deployment/webapp \
  -n staging \
  --timeout=5m

kubectl get pods -n staging -o wide
```

